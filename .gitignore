# 默认忽略本地资料，只开放明确列出的项目文件。
/*
!/.gitignore
!/README.md
!/requirements.txt
!/scripts/
/scripts/*
!/scripts/收作业.py
!/scripts/回作业.py
!/scripts/生成网页.py
!/scripts/整理学生邮箱.py
!/tests/
/tests/*
!/tests/验证网页.py
!/tests/验证跨周统计.py
!/templates/
/templates/*
!/templates/网页模板.html
!/邮箱配置.example.ps1
!/docs/
/docs/*
!/docs/使用指南.md
!/docs/收作业使用说明.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/site/
/site/*
!/site/index.html
